{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    // TODO: Revisit ES2022 for a future major release after defining and testing
    // the supported browser baseline. This emits native private fields, which
    // older browsers cannot parse.
    // "target": "ES2022",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "./*.config.*"],
  "exclude": ["src/__tests__/**/*"]
}
