{
  "name": "chartjs-plugin-tailwindcss-colors",
  "version": "0.2.5",
  "author": "Danry Parens Patriae Ague <ague.danryparenspatriae@gmail.com>",
  "description": "Colorize your Chart.js components using TailwindCSS!",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/plugin.umd.js",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "cross-env NODE_ENV=production pnpm build",
    "watch": "rollup -c --configPlugin rollup-plugin-ts -w",
    "dev": "conc -n R,J -c red,magenta -k \"pnpm watch\" \"pnpm test:dev\"",
    "build": "rollup -c",
    "test": "jest --coverage",
    "test:dev": "jest --watch",
    "format:checkonly": "prettier -c --cache .",
    "format": "prettier -uw --cache .",
    "lint:ts": "tsc --noEmit",
    "lint:es": "eslint .",
    "lint:es:fix": "pnpm lint:es --fix",
    "stylecheck": "conc -c auto -n pt \"pnpm:format:checkonly\" \"pnpm:lint:*(!fix)\"",
    "stylefix": "pnpm format && conc -c auto \"pnpm:lint:*:fix\""
  },
  "homepage": "https://github.com/decanTyme/chartjs-plugin-tailwindcss-colors#readme",
  "bugs": "https://github.com/decanTyme/chartjs-plugin-tailwindcss-colors/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decanTyme/chartjs-plugin-tailwindcss-colors.git"
  },
  "keywords": [
    "chartjs",
    "chart.js",
    "tailwindcss",
    "colors",
    "class",
    "plugin",
    "parser"
  ],
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "browser": "./dist/plugin.umd.js",
    "default": "./dist/index.cjs"
  },
  "dependencies": {
    "color-name": "^2.0.0",
    "lodash": "^4.17.21",
    "tiny-invariant": "^1.3.1"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "@kayahr/jest-electron-runner": "^29.15.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/color-name": "^1.1.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.7",
    "@types/pixelmatch": "^5.2.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chart.js": "^3.9.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-unicorn": "^50.0.1",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "pixelmatch": "^5.3.0",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-ts": "^3.4.5",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "chart.js": "^3.0.0",
    "tailwindcss": "^3.0.0"
  }
}
